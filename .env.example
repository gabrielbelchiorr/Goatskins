# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Em produção use: production
NODE_ENV=development
PORT=3000

# Em produção: https://goatskins.com.br (origem principal e links dos e-mails)
APP_URL=http://localhost:3000

# ---------- Banco de dados (PostgreSQL) ----------
# Desenvolvimento local: um PostgreSQL local, por exemplo com Docker:
#   docker run --name goatskins-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=goatskins -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goatskins
# Produção no Render: cole a "Internal Database URL" do seu PostgreSQL (só no painel do Render, nunca no GitHub).
# SSL: ligado sozinho quando o host termina em .render.com (External URL); a Internal URL não usa SSL.
# Para forçar: DATABASE_SSL=1 | para desligar: DATABASE_SSL=0
#DATABASE_SSL=
# Conexões simultâneas máximas com o banco (padrão 10).
#PG_POOL_MAX=10
# Só para scripts/migrar-sqlite.js: caminho do arquivo SQLite antigo (padrão ./data/goatskins.db).
#SQLITE_PATH=./data/goatskins.db
DATA_DIR=./data

# E-mail: "console" grava os e-mails em data/emails.log (bom para testar).
# Para enviar de verdade: EMAIL_DRIVER=resend, crie conta em resend.com e cole a chave em EMAIL_API_KEY.
EMAIL_DRIVER=console
EMAIL_API_KEY=
EMAIL_FROM=GOATSKINS <no-reply@seudominio.com.br>

# Use 1 SOMENTE se o site ficar atrás de um proxy confiável (Caddy, Nginx).
TRUST_PROXY=0

# ---------- Mercado Pago (Pix) ----------
# NUNCA coloque estes valores no código, no GitHub nem em mensagens. Só no .env do SERVIDOR.
# Access Token: mercadopago.com.br/developers > Suas integrações > sua aplicação > Credenciais.
#   Use as credenciais de TESTE para testar e troque pelas de PRODUÇÃO só no lançamento.
MP_ACCESS_TOKEN=
# Chave secreta do webhook: Suas integrações > sua aplicação > Webhooks > Configurar notificações
#   (URL: https://seudominio.com.br/api/webhooks/mercadopago | evento: "Order (Mercado Pago)").
MP_WEBHOOK_SECRET=
# Validade do Pix em minutos (mínimo 30 no Mercado Pago). Os números ficam reservados +5 min de folga.
PIX_MINUTOS=30

# Quantos proxies confiáveis existem na frente do Node (padrão 1). No Render, confira em Admin > Logs se os IPs
# mudam de pessoa para pessoa; se todos aparecerem iguais (IP do proxy), tente TRUST_PROXY_HOPS=2.
TRUST_PROXY_HOPS=1

# ---------- Só para os testes de API (npm run test:api) ----------
# Banco SEPARADO e descartável. O teste APAGA todas as tabelas dele; por segurança o nome do banco precisa conter "test".
#TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goatskins_test

# ---------- Confirmação de cadastro ----------
# Obrigatório em produção: gere um segredo único com o comando abaixo e cole SOMENTE no Render/.env.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# EMAIL_CODE_SECRET deve ser igual em todas as instâncias. Trocar invalida códigos pendentes.
EMAIL_CODE_SECRET=
# No Render: NODE_ENV=production, EMAIL_DRIVER=resend, EMAIL_API_KEY=<chave do Resend>,
# EMAIL_FROM=GOATSKINS <no-reply@seu-dominio-verificado>, APP_URL=https://goatskins.com.br,
# TRUST_PROXY=1. Não use remetente @resend.dev em produção. Nunca use TESTE=1 no Render.
# Códigos: 10 min; solicitação: 30 min; reenvio: 60 s; até 5 mensagens/h por endereço.

# ---------- Proteções de produção (obrigatórias) ----------
# Cloudflare Turnstile: widget Managed, hostname igual ao APP_URL. Site key é pública; secret só no servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional APÓS configurar seu novo domínio: aliases exatos autorizados no Cloudflare.
# Ex.: TURNSTILE_HOSTNAMES=goatskins.com.br,www.goatskins.com.br,goatskins.onrender.com
# TURNSTILE_HOSTNAMES=
# Gere 32 bytes aleatórios em HEX, independente de EMAIL_CODE_SECRET. Guarde cópia segura:
# perder/trocar esta chave impede ler os segredos MFA existentes. Nunca envie esta chave.
MFA_ENCRYPTION_KEY=
# ---------- Origem protegida por Cloudflare (opcional, ativar POR ÚLTIMO) ----------
# Só depois de os registros web usarem o proxy Cloudflare e de uma Request Header
# Transform Rule inserir x-goatskins-origin em TODAS as requisições para o site.
# Gere OUTRO segredo de 32 bytes em HEX e use o mesmo valor na regra e no Render.
# A regra deve sobrescrever o header recebido, não apenas adicionar um segundo valor.
# Webhook Pix precisa apontar para https://goatskins.com.br/api/webhooks/mercadopago.
# /healthz GET/HEAD continua acessível ao monitor do Render. Todo o resto exige o header.
# Deixe vazio enquanto terminar DNS, certificado, Turnstile e webhook; preencher antes bloqueia o site.
ORIGIN_VERIFY_SECRET=
# Certificado CA PEM opcional para PostgreSQL TLS. Validação de certificado permanece obrigatória.
# DATABASE_CA=
# Celular obrigatório: validação brasileira/E.164, sem SMS ou Twilio.
# Nenhuma credencial ou configuração de provedor SMS é necessária.
