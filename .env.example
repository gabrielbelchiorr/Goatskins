# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Em produção use: production
NODE_ENV=development
PORT=3000

# Em produção: https://seudominio.com.br (usado nos links dos e-mails)
APP_URL=http://localhost:3000
DATABASE_PATH=./data/goatskins.db
DATA_DIR=./data

# E-mail: "console" grava os e-mails em data/emails.log (bom para testar).
# Para enviar de verdade: EMAIL_DRIVER=resend, crie conta em resend.com e cole a chave em EMAIL_API_KEY.
EMAIL_DRIVER=console
EMAIL_API_KEY=
EMAIL_FROM=GOATSKINS <no-reply@seudominio.com.br>

# Use 1 SOMENTE se o site ficar atrás de um proxy confiável (Caddy, Nginx).
TRUST_PROXY=0

# ---------- Mercado Pago (Pix) ----------
# NUNCA coloque estes valores no código, no GitHub nem em mensagens. Só no .env do SERVIDOR.
# Access Token: mercadopago.com.br/developers > Suas integrações > sua aplicação > Credenciais.
#   Use as credenciais de TESTE para testar e troque pelas de PRODUÇÃO só no lançamento.
MP_ACCESS_TOKEN=
# Chave secreta do webhook: Suas integrações > sua aplicação > Webhooks > Configurar notificações
#   (URL: https://seudominio.com.br/api/webhooks/mercadopago | evento: "Order (Mercado Pago)").
MP_WEBHOOK_SECRET=
# Validade do Pix em minutos (mínimo 30 no Mercado Pago). Os números ficam reservados +5 min de folga.
PIX_MINUTOS=30
